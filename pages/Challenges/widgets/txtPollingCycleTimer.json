  "text": "{{\n  (() => {\n    appsmith.store.pollTick; // forces re-evaluation every second\n\n    const end = appsmith.store.pollingEndTime;\n\n    // No cycle has been started yet\n    if (!end) return \"- No Polls in Progress -\";\n\n    const ms = jsChallengeOrchestrator.getPollingRemaining();\n\n    // Cycle reached zero\n    if (ms <= 0) return \"Polling Cycle Ended\";\n\n    const seconds = Math.floor(ms / 1000) % 60;\n    const minutes = Math.floor(ms / 60000);\n\n    return `Poll Cycle Countdown: ${minutes}m ${seconds.toString().padStart(2, \"0\")}s`;\n  })()\n}}\n",
